<Window x:Class="PCHardwareMonitor.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra"
        Width="430"
        Height="168"
        MinWidth="430"
        MinHeight="168"
        MaxWidth="430"
        MaxHeight="168"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <Window.Resources>

        <Style x:Key="NotificationCloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="26"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="18"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Cursor"
                    Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="NotificationMessageStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="LineHeight"
                    Value="16"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>


    <Grid x:Name="RootGrid"
          Cursor="Hand"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">

        <!-- ===================================================== -->
        <!-- CYBER TECH                                            -->
        <!-- ===================================================== -->

        <Border Visibility="{DynamicResource CyberTechVisibility}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Border Height="3"
                        VerticalAlignment="Top"
                        Margin="18,0,80,0"
                        Background="{DynamicResource AccentBrush}"/>

                <Border Width="1"
                        Margin="13,14,0,14"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource BorderBrush}"
                        Opacity="0.65"/>

                <Border x:Name="CyberSeverityBar"
                        Width="4"
                        Margin="0,18,0,18"
                        HorizontalAlignment="Left"/>

                <Grid Margin="20,13,12,13">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <Border Width="24"
                                    Height="1"
                                    Margin="8,0"
                                    Background="{DynamicResource BorderBrush}"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="SYSTEM ALERT"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                Content="×"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,5,28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CyberSeverityBadge"
                                Padding="7,3"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="CyberTypeText"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="CyberTitleText"
                                   Grid.Column="2"
                                   Style="{StaticResource NotificationTitleStyle}"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock x:Name="CyberMessageText"
                               Grid.Row="2"
                               Style="{StaticResource NotificationMessageStyle}"
                               Margin="0,8,18,0"
                               MaxHeight="48"/>

                    <Grid IsHitTestVisible="False"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Width="62"
                          Height="24"
                          Opacity="0.28">

                        <Border Width="1"
                                Height="24"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center"/>

                        <Border Width="62"
                                Height="1"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"/>

                        <Ellipse Width="13"
                                 Height="13"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1"/>

                    </Grid>

                </Grid>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- STEAMPUNK                                             -->
        <!-- ===================================================== -->

        <Border Visibility="{DynamicResource SteamPunkVisibility}"
                Background="{DynamicResource SteamPanelBrush}"
                BorderBrush="{DynamicResource SteamMetalBrush}"
                BorderThickness="2"
                CornerRadius="10">

            <Grid>

                <Border Margin="5"
                        BorderBrush="{DynamicResource SteamDarkMetalBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        IsHitTestVisible="False"/>

                <Ellipse Width="7"
                         Height="7"
                         Margin="9"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource SteamRivetBrush}"/>

                <Ellipse Width="7"
                         Height="7"
                         Margin="9"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource SteamRivetBrush}"/>

                <Ellipse Width="7"
                         Height="7"
                         Margin="9"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource SteamRivetBrush}"/>

                <Ellipse Width="7"
                         Height="7"
                         Margin="9"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource SteamRivetBrush}"/>

                <Grid Margin="22,14,14,14">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="Georgia"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="  •  MECHANICAL SIGNAL"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                Content="×"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,7,30,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="SteamSeverityBadge"
                                Padding="8,3"
                                Background="{DynamicResource SteamGlassBrush}"
                                BorderThickness="1"
                                CornerRadius="5">

                            <TextBlock x:Name="SteamTypeText"
                                       FontFamily="Georgia"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="SteamTitleText"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Georgia"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock x:Name="SteamMessageText"
                               Grid.Row="2"
                               Style="{StaticResource NotificationMessageStyle}"
                               Margin="0,8,24,0"
                               MaxHeight="48"/>

                    <Border Width="74"
                            Height="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource SteamMetalBrush}"
                            Opacity="0.65"
                            IsHitTestVisible="False"/>

                </Grid>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- FROST CORE                                            -->
        <!-- ===================================================== -->

        <Border Visibility="{DynamicResource FrostCoreVisibility}"
                Background="{DynamicResource FrostPanelBrush}"
                BorderBrush="{DynamicResource FrostSteelBrush}"
                BorderThickness="1"
                CornerRadius="12">

            <Grid>

                <Border Height="4"
                        Margin="24,0,24,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource FrostIceBrush}"
                        CornerRadius="0,0,5,5"
                        Opacity="0.85"/>

                <Border Margin="5"
                        BorderBrush="{DynamicResource FrostSteelBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Opacity="0.55"
                        IsHitTestVisible="False"/>

                <Grid Margin="18,13,12,13">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30"
                                Height="30"
                                Background="{DynamicResource FrostGlassBrush}"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="1"
                                CornerRadius="9">

                            <TextBlock Text="❄"
                                       Foreground="{DynamicResource FrostIceBrush}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="CRYO ALERT CHANNEL"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                        <Button Grid.Column="3"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                Content="×"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,7,30,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FrostSeverityBadge"
                                Padding="8,3"
                                Background="{DynamicResource FrostGlassBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <TextBlock x:Name="FrostTypeText"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="FrostTitleText"
                                   Grid.Column="2"
                                   Style="{StaticResource NotificationTitleStyle}"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock x:Name="FrostMessageText"
                               Grid.Row="2"
                               Style="{StaticResource NotificationMessageStyle}"
                               Margin="0,8,22,0"
                               MaxHeight="48"/>

                    <Border x:Name="FrostSeverityBar"
                            Width="4"
                            Height="58"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            Opacity="0.80"/>

                </Grid>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MILITARY OPS                                          -->
        <!-- ===================================================== -->

        <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                Background="{DynamicResource MilitaryPanelBrush}"
                BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                BorderThickness="1"
                CornerRadius="1">

            <Grid>

                <Border Height="3"
                        Margin="18,0,150,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource MilitaryKhakiBrush}"/>

                <Grid Margin="17,12,12,12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="31"
                              Height="31">

                            <Ellipse Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="1"/>

                            <Border Width="1"
                                    Height="27"
                                    Background="{DynamicResource MilitaryGridBrush}"/>

                            <Border Width="27"
                                    Height="1"
                                    Background="{DynamicResource MilitaryGridBrush}"/>

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource AccentBrush}"/>

                        </Grid>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA // FIELD ALERT"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="Bahnschrift"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock Text="TACTICAL MONITORING CHANNEL"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontFamily="Bahnschrift"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                        <Button Grid.Column="3"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                FontFamily="Bahnschrift"
                                Content="×"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,7,30,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="MilitarySeverityBadge"
                                Padding="8,3"
                                Background="{DynamicResource MilitaryPlateBrush}"
                                BorderThickness="1"
                                CornerRadius="1">

                            <TextBlock x:Name="MilitaryTypeText"
                                       FontFamily="Bahnschrift"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="MilitaryTitleText"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Bahnschrift"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock x:Name="MilitaryMessageText"
                               Grid.Row="2"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               LineHeight="16"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,24,0"
                               MaxHeight="48"/>

                    <Grid Width="72"
                          Height="28"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Opacity="0.34"
                          IsHitTestVisible="False">

                        <Border Width="1"
                                Height="28"
                                Background="{DynamicResource MilitaryGridBrush}"/>

                        <Border Width="72"
                                Height="1"
                                Background="{DynamicResource MilitaryGridBrush}"/>

                        <Ellipse Width="13"
                                 Height="13"
                                 Stroke="{DynamicResource MilitaryKhakiBrush}"
                                 StrokeThickness="1"/>

                    </Grid>

                    <Border x:Name="MilitarySeverityBar"
                            Width="4"
                            Height="58"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
