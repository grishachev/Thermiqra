<Window x:Class="PCHardwareMonitor.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra — Статистика"
        Width="1120"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource WindowBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SmallValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatisticsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
        </Style>

        <Style x:Key="StatisticsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
                        <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource MiniCardCornerRadius}">
                                <Grid>
                                    <ContentPresenter Margin="10,0,34,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
                                                      IsHitTestVisible="False"/>
                                    <Path Width="9"
                                          Height="5"
                                          Margin="0,0,12,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource SecondaryTextBrush}"
                                          Data="M 0 0 L 4.5 5 L 9 0 Z"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SettingsInputBrush}"
                                        BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource MiniCardCornerRadius}">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основное содержимое свободно растягивается вместе с окном. -->
    <Grid Margin="22"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="THERMIQRA / СТАТИСТИКА"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="{DynamicResource DisplayFontFamily}"
                           FontSize="24"
                           FontWeight="Bold"/>

                <Grid Margin="0,4,0,0">
                    <TextBlock Text="АРХИВ ДАТЧИКОВ // HISTORY NODE"
                               Visibility="{DynamicResource MainCyberTechVisibility}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"/>
                    <TextBlock Text="МЕХАНИЧЕСКИЙ ЖУРНАЛ ПОКАЗАНИЙ"
                               Visibility="{DynamicResource SteamPunkVisibility}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="11"/>
                    <TextBlock Text="КРИОТЕЛЕМЕТРИЯ // АРХИВ ДАТЧИКОВ"
                               Visibility="{DynamicResource FrostCoreVisibility}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"/>
                    <TextBlock Text="ПОЛЕВАЯ ТЕЛЕМЕТРИЯ // LOG ARCHIVE"
                               Visibility="{DynamicResource MilitaryOpsVisibility}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="11"/>
                </Grid>
            </StackPanel>

            <Border Grid.Column="1"
                    Style="{StaticResource StatisticsPanelStyle}"
                    Padding="12,8"
                    MinWidth="116">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="ТОЧЕК В ПЕРИОДЕ"
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SampleCountText"
                               Text="0"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Разный статичный декор шапки для каждого скина. -->
            <Border Height="2"
                    VerticalAlignment="Bottom"
                    Margin="0,0,160,-9"
                    Background="{DynamicResource AccentBrush}"
                    Visibility="{DynamicResource MainCyberTechVisibility}"/>

            <Grid VerticalAlignment="Bottom"
                  Margin="0,0,160,-10"
                  Height="6"
                  Visibility="{DynamicResource SteamPunkVisibility}">
                <Border Height="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SteamMetalBrush}"/>
                <Ellipse Width="6" Height="6"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource SteamRivetBrush}"/>
                <Ellipse Width="6" Height="6"
                         HorizontalAlignment="Right"
                         Fill="{DynamicResource SteamRivetBrush}"/>
            </Grid>

            <Grid VerticalAlignment="Bottom"
                  Margin="0,0,160,-10"
                  Height="7"
                  Visibility="{DynamicResource FrostCoreVisibility}">
                <Border Height="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource FrostIceBrush}"/>
                <Border Width="74" Height="3"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource FrostIceBrush}"/>
            </Grid>

            <Grid VerticalAlignment="Bottom"
                  Margin="0,0,160,-10"
                  Height="7"
                  Visibility="{DynamicResource MilitaryOpsVisibility}">
                <Border Height="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource MilitaryKhakiBrush}"/>
                <Border Width="46" Height="5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MilitaryKhakiBrush}"/>
            </Grid>
        </Grid>


        <!-- ФОНОВЫЙ WATERMARK СКИНА. Только статичный декор, без анимаций. -->
        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              IsHitTestVisible="False"
              ClipToBounds="True">

            <!-- CYBER TECH: концентрический HUD-модуль. -->
            <Grid Width="720"
                  Height="720"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,70,0,0"
                  Opacity="0.045"
                  Visibility="{DynamicResource MainCyberTechVisibility}">
                <Ellipse Margin="42"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="2"/>
                <Ellipse Margin="120"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="1"/>
                <Ellipse Margin="210"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="2"/>
                <Border Width="2" Height="650"
                        Background="{DynamicResource AccentBrush}"/>
                <Border Width="650" Height="2"
                        Background="{DynamicResource AccentBrush}"/>
                <Border Width="410" Height="1"
                        Background="{DynamicResource BorderBrush}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <Border Width="410" Height="1"
                        Background="{DynamicResource BorderBrush}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-45"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- STEAMPUNK: крупная шестерня как водяной знак. -->
            <TextBlock Text="⚙"
                       FontFamily="Segoe UI Symbol"
                       FontSize="650"
                       Foreground="{DynamicResource SteamMetalBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,90,0,0"
                       Opacity="0.05"
                       Visibility="{DynamicResource SteamPunkVisibility}"/>

            <!-- FROST CORE: большая снежинка как у криокамер. -->
            <TextBlock Text="❄"
                       FontFamily="Segoe UI Symbol"
                       FontSize="620"
                       Foreground="{DynamicResource FrostIceBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,85,0,0"
                       Opacity="0.05"
                       Visibility="{DynamicResource FrostCoreVisibility}"/>

            <!-- MILITARY OPS: тактическая прицельная/компасная метка. -->
            <Grid Width="700"
                  Height="700"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,80,0,0"
                  Opacity="0.055"
                  Visibility="{DynamicResource MilitaryOpsVisibility}">
                <Ellipse Margin="48"
                         Stroke="{DynamicResource MilitaryKhakiBrush}"
                         StrokeThickness="2"/>
                <Ellipse Margin="175"
                         Stroke="{DynamicResource MilitaryGridBrush}"
                         StrokeThickness="2"/>
                <Border Width="2" Height="620"
                        Background="{DynamicResource MilitaryKhakiBrush}"/>
                <Border Width="620" Height="2"
                        Background="{DynamicResource MilitaryKhakiBrush}"/>
                <TextBlock Text="N"
                           Foreground="{DynamicResource MilitaryKhakiBrush}"
                           FontFamily="Bahnschrift"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,30,0,0"/>
                <TextBlock Text="THERMIQRA"
                           Foreground="{DynamicResource MilitaryKhakiBrush}"
                           FontFamily="Bahnschrift"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- ПЕРИОД -->
        <Border Grid.Row="1"
                Style="{StaticResource StatisticsPanelStyle}"
                Padding="14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ПЕРИОД"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="TodayButton"
                            Content="Сегодня"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Click="TodayButton_Click"/>
                    <Button x:Name="Last24HoursButton"
                            Content="24 часа"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Click="Last24HoursButton_Click"/>
                    <Button x:Name="Last7DaysButton"
                            Content="7 дней"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Click="Last7DaysButton_Click"/>
                    <Button x:Name="Last30DaysButton"
                            Content="30 дней"
                            MinWidth="100"
                            Click="Last30DaysButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="PeriodRangeText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="18,0,0,0"/>
            </Grid>
        </Border>

        <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
        <ScrollViewer x:Name="StatisticsScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- КРАТКАЯ СВОДКА -->
                <TextBlock Text="КРАТКАЯ СВОДКА"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource StatisticsPanelStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="56"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="CPU / МАКС. ТЕМПЕРАТУРА"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="CpuMaxTemperatureText"
                                           Text="—"
                                           Style="{StaticResource ValueStyle}"
                                           Margin="0,7,0,0"/>
                                <TextBlock x:Name="CpuMaxTemperatureTimeText"
                                           Text="Нет данных"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatisticsPanelStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="56"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="GPU / МАКС. ТЕМПЕРАТУРА"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="GpuMaxTemperatureText"
                                           Text="—"
                                           Style="{StaticResource ValueStyle}"
                                           Margin="0,7,0,0"/>
                                <TextBlock x:Name="GpuMaxTemperatureDeviceText"
                                           Text="Нет данных"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatisticsPanelStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="56"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="RAM / МАКС. ЗАГРУЗКА"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="RamMaxLoadText"
                                           Text="—"
                                           Style="{StaticResource ValueStyle}"
                                           Margin="0,7,0,0"/>
                                <TextBlock x:Name="RamMaxLoadTimeText"
                                           Text="Нет данных"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatisticsPanelStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="56"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="САМЫЙ ГОРЯЧИЙ НАКОПИТЕЛЬ"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="StorageMaxTemperatureText"
                                           Text="—"
                                           Style="{StaticResource ValueStyle}"
                                           Margin="0,7,0,0"/>
                                <TextBlock x:Name="StorageMaxTemperatureDeviceText"
                                           Text="Нет данных"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- CPU И RAM -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource StatisticsPanelStyle}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="CPU"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,3"/>

                            <TextBlock x:Name="CpuHardwareNameText"
                                       Text="Модель процессора"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,13"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                    <TextBlock Text="Средняя температура" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="CpuAverageTemperatureText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Макс. температура" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="CpuDetailMaxTemperatureText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Средняя загрузка" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="CpuAverageLoadText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Макс. загрузка" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="CpuMaxLoadText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource StatisticsPanelStyle}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="RAM"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,3"/>

                            <TextBlock x:Name="RamHardwareInfoText"
                                       Text="Общий объём оперативной памяти"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,13"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Средняя загрузка" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="RamAverageLoadText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Макс. загрузка" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="RamDetailMaxLoadText" Text="—" Style="{StaticResource SmallValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- ГРАФИК -->
                <TextBlock Text="ГРАФИК ПО ВРЕМЕНИ"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource StatisticsPanelStyle}"
                        Padding="18"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="280"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="ChartTitleText"
                                           Text="CPU / ТЕМПЕРАТУРА"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Статичный график по сохранённым точкам. Обновляется при выборе периода или показателя."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="УСТРОЙСТВО"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ChartSourceComboBox"
                                              Width="220"
                                              Style="{StaticResource StatisticsComboBoxStyle}"
                                              PreviewMouseWheel="ChartSelector_PreviewMouseWheel"
                                              SelectionChanged="ChartSourceComboBox_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ПОКАЗАТЕЛЬ"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ChartMetricComboBox"
                                              Width="180"
                                              Style="{StaticResource StatisticsComboBoxStyle}"
                                              PreviewMouseWheel="ChartSelector_PreviewMouseWheel"
                                              SelectionChanged="ChartMetricComboBox_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="СРЕДНЕЕ" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="ChartAverageText"
                                           Text="—"
                                           Style="{StaticResource SmallValueStyle}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                <TextBlock Text="МАКСИМУМ" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="ChartMaximumText"
                                           Text="—"
                                           Style="{StaticResource SmallValueStyle}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="28,0,0,0">
                                <TextBlock Text="ВРЕМЯ МАКСИМУМА" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="ChartMaximumTimeText"
                                           Text="—"
                                           Style="{StaticResource SmallValueStyle}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SettingsInputBrush}"
                                BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="ChartCanvas"
                                        Margin="8"
                                        ClipToBounds="True"
                                        SizeChanged="ChartCanvas_SizeChanged"/>
                                <TextBlock x:Name="ChartEmptyText"
                                           Text="За выбранный период данных для графика пока нет."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- GPU -->
                <TextBlock Text="ВИДЕОКАРТЫ"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <Grid x:Name="GpuDetailsPanel"
                      Margin="0,0,0,20"/>

                <!-- НАКОПИТЕЛИ -->
                <TextBlock Text="ФИЗИЧЕСКИЕ НАКОПИТЕЛИ"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <Grid x:Name="StorageDetailsPanel"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ПОДВАЛ -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="История сохраняется примерно раз в минуту"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="ExportCsvButton"
                        Content="Экспорт CSV"
                        MinWidth="130"
                        Margin="0,0,10,0"
                        Click="ExportCsvButton_Click"/>

                <Button Content="Закрыть"
                        MinWidth="100"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
