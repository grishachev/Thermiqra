<Window x:Class="PCHardwareMonitor.StorageAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra — Анализ диска"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="PanelBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource PanelCornerRadius}"/>
        </Style>

        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Padding"
                    Value="16,13"/>
        </Style>


        <Style x:Key="SummaryActionCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource SummaryCardStyle}">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background"
                            Value="{DynamicResource InputBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="StorageScrollThumbStyle"
               TargetType="Thumb">
            <Setter Property="Background"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="MinHeight"
                    Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="9"/>
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource StorageScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation"
                                     Value="Horizontal">
                                <Setter Property="Height"
                                        Value="9"/>
                                <Setter Property="Width"
                                        Value="Auto"/>
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource GaugeTrackBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeExpanderStyle"
               TargetType="ToggleButton">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Width"
                    Value="18"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Arrow"
                                       Text="▶"
                                       FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Arrow"
                                        Property="Text"
                                        Value="▼"/>
                                <Setter TargetName="Arrow"
                                        Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorageTreeItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                    Padding="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource TreeExpanderStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="18,0,0,0"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems"
                                     Value="False">
                                <Setter TargetName="Expander"
                                        Property="Visibility"
                                        Value="Hidden"/>
                            </Trigger>

                            <Trigger Property="IsExpanded"
                                     Value="False">
                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                               Value="True"/>
                                    <Condition Property="IsSelected"
                                               Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>
                            </MultiTrigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="HeaderBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             ТЕМАТИЧЕСКАЯ ШАПКА
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,14">

            <!-- CYBER TECH -->
            <Border Visibility="{DynamicResource CyberTechVisibility}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="54"
                              Height="54"
                              Margin="0,0,16,0">
                            <Border BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"/>
                            <Border Width="34"
                                    Height="22"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Border Width="22"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="DRV"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CyberMetaText"
                                       Text="THERMIQRA / STORAGE NAVIGATOR"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="CyberTitleText"
                                       Text="КУДА УШЛО МЕСТО"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>

                            <TextBlock x:Name="CyberSubtitleText"
                                       Text="Быстрый путь к самым тяжёлым папкам и файлам"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="CyberDriveCaptionText"
                                           Text="ДИСК"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="CyberDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- STEAMPUNK -->
            <Border Visibility="{DynamicResource SteamPunkVisibility}"
                    Background="{DynamicResource SteamPanelBrush}"
                    BorderBrush="{DynamicResource SteamMetalBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Ellipse Stroke="{DynamicResource SteamMetalBrush}"
                                     StrokeThickness="3"
                                     Fill="{DynamicResource SteamGlassBrush}"/>
                            <Ellipse Width="40"
                                     Height="40"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1"/>
                            <Border Width="38"
                                    Height="5"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Ellipse Width="18"
                                     Height="18"
                                     Fill="{DynamicResource SteamDarkMetalBrush}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2"/>
                            <TextBlock Text="D"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SteamMetaText"
                                       Text="THERMIQRA / МЕХАНИЧЕСКИЙ НАВИГАТОР НАКОПИТЕЛЯ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="SteamTitleText"
                                       Text="КУДА УШЛО МЕСТО"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="SteamSubtitleText"
                                       Text="Thermiqra показывает путь от диска до самых тяжёлых данных"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource SteamGlassBrush}"
                                BorderBrush="{DynamicResource SteamMetalBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="SteamDriveCaptionText"
                                           Text="НАКОПИТЕЛЬ"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="SteamDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SteamMetalBrush}"/>
                </Grid>
            </Border>

            <!-- FROST CORE -->
            <Border Visibility="{DynamicResource FrostCoreVisibility}"
                    Background="{DynamicResource FrostPanelBrush}"
                    BorderBrush="{DynamicResource FrostSteelBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource FrostIceBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Border BorderBrush="{DynamicResource FrostSteelBrush}"
                                    BorderThickness="2"
                                    CornerRadius="18"
                                    Background="{DynamicResource FrostGlassBrush}"/>
                            <Ellipse Width="38"
                                     Height="38"
                                     Stroke="{DynamicResource FrostIceBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.8"/>
                            <TextBlock Text="❄"
                                       Foreground="{DynamicResource FrostIceBrush}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="FrostMetaText"
                                       Text="THERMIQRA / CRYO STORAGE NAVIGATOR"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="FrostTitleText"
                                       Text="КУДА УШЛО МЕСТО"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="FrostSubtitleText"
                                       Text="Крупные ветки накопителя видны сразу"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource FrostGlassBrush}"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="FrostDriveCaptionText"
                                           Text="ДИСК"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="FrostDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource FrostIceBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- MILITARY OPS -->
            <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                    Background="{DynamicResource MilitaryPanelBrush}"
                    BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Ellipse Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="2"
                                     Fill="{DynamicResource MilitaryPlateBrush}"/>
                            <Ellipse Width="34"
                                     Height="34"
                                     Stroke="{DynamicResource MilitaryGridBrush}"
                                     StrokeThickness="1"/>
                            <Border Width="1"
                                    Height="42"
                                    Background="{DynamicResource MilitaryGridBrush}"
                                    HorizontalAlignment="Center"/>
                            <Border Width="42"
                                    Height="1"
                                    Background="{DynamicResource MilitaryGridBrush}"
                                    VerticalAlignment="Center"/>
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{DynamicResource AccentBrush}"
                                     Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="1"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="MilitaryMetaText"
                                       Text="THERMIQRA / TACTICAL STORAGE NAVIGATOR"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="MilitaryTitleText"
                                       Text="КУДА УШЛО МЕСТО"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="MilitarySubtitleText"
                                       Text="Тактический маршрут к самым тяжёлым данным"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource MilitaryPlateBrush}"
                                BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="MilitaryDriveCaptionText"
                                           Text="ДИСК"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="MilitaryDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource MilitaryKhakiBrush}"/>
                </Grid>
            </Border>

        </Grid>

        <!-- =====================================================
             ОСНОВНОЕ СОДЕРЖИМОЕ
             ===================================================== -->

        <Grid Grid.Row="1">

            <Border x:Name="LoadingCard"
                    Style="{StaticResource SummaryCardStyle}"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LoadingTitleText"
                                   Text="Анализ диска..."
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="LoadingDescriptionText"
                                   Text="Thermiqra читает структуру накопителя. Главное окно продолжает работать."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="AnalysisContentGrid"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- БЫСТРАЯ СВОДКА -->
                <Grid x:Name="SummaryGrid"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LargestBranchCard"
                            Grid.Column="0"
                            Style="{StaticResource SummaryActionCardStyle}"
                            Margin="0,0,7,0"
                            ToolTip="Показать в дереве"
                            MouseLeftButtonUp="LargestBranchCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="◔"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="28"
                                       VerticalAlignment="Center"
                                       Margin="0,0,13,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LargestBranchCaptionText"
                                           Text="САМАЯ БОЛЬШАЯ ВЕТКА"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="LargestBranchNameText"
                                           Text="—"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                                <TextBlock x:Name="LargestBranchSizeText"
                                           Text="—"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="LargestFileCard"
                            Grid.Column="1"
                            Style="{StaticResource SummaryActionCardStyle}"
                            Margin="7,0"
                            ToolTip="Показать файл в дереве"
                            MouseLeftButtonUp="LargestFileCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="▤"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="27"
                                       VerticalAlignment="Center"
                                       Margin="0,0,13,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LargestFileCaptionText"
                                           Text="КРУПНЕЙШИЙ ФАЙЛ"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="LargestFileNameText"
                                           Text="—"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                                <TextBlock x:Name="LargestFileSizeText"
                                           Text="—"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="SafeCandidatesCard"
                            Grid.Column="2"
                            Style="{StaticResource SummaryActionCardStyle}"
                            Margin="7,0,0,0"
                            ToolTip="Показать только безопасные кандидаты"
                            MouseLeftButtonUp="SafeCandidatesCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⌫"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="29"
                                       VerticalAlignment="Center"
                                       Margin="0,0,13,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PotentialCleanupCaptionText"
                                           Text="БЕЗОПАСНАЯ ОЧИСТКА"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="PotentialCleanupValueText"
                                           Text="—"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,3,0,0"/>
                                <TextBlock x:Name="PotentialCleanupHintText"
                                           Text=""
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <!-- ПОЛЬЗОВАТЕЛЬСКИЕ ОБЛАСТИ -->
                <Grid x:Name="UserActionCardsGrid"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DownloadsCard"
                            Grid.Column="0"
                            Style="{StaticResource PanelBorderStyle}"
                            Padding="14"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DownloadsCaptionText"
                                       Text="ЗАГРУЗКИ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="DownloadsValueText"
                                       Text="—"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="DownloadsHintText"
                                       Text="Личные файлы пользователя. Решение об удалении принимает пользователь."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0">
                                <Button x:Name="ViewDownloadsButton"
                                        Content="Посмотреть"
                                        MinWidth="105"
                                        Margin="0,0,8,0"
                                        Click="ViewDownloadsButton_Click"/>

                                <Button x:Name="ClearDownloadsButton"
                                        Content="Очистить папку"
                                        MinWidth="125"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Click="ClearDownloadsButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecycleCard"
                            Grid.Column="2"
                            Style="{StaticResource PanelBorderStyle}"
                            Padding="14"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="RecycleCaptionText"
                                       Text="КОРЗИНА"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="RecycleValueText"
                                       Text="—"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="RecycleHintText"
                                       Text="Удалённые файлы всё ещё занимают место и пока могут быть восстановлены."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0">
                                <Button x:Name="ViewRecycleButton"
                                        Content="Посмотреть"
                                        MinWidth="105"
                                        Margin="0,0,8,0"
                                        Click="ViewRecycleButton_Click"/>

                                <Button x:Name="ClearRecycleButton"
                                        Content="Очистить корзину"
                                        MinWidth="135"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Click="ClearRecycleButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ДЕРЕВО + ПОЯСНЕНИЕ -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource PanelBorderStyle}"
                            Padding="0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="SafeModeBar"
                                    Grid.Row="0"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource GaugeTrackBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="SafeModeTitleText"
                                                   Text="Можно безопасно проверить"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="SafeModeSubtitleText"
                                                   Text=""
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="BackToAllButton"
                                            Grid.Column="1"
                                            Content="← Все данные"
                                            Padding="10,5"
                                            MinWidth="100"
                                            Margin="12,0,0,0"
                                            Click="BackToAllButton_Click"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1"
                                  Margin="14,10,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NameColumnText"
                                           Text="Имя"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="SizeColumnText"
                                           Grid.Column="1"
                                           Text="Размер"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="ShareColumnText"
                                           Grid.Column="2"
                                           Text="Доля"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    VerticalAlignment="Bottom"/>

                            <TreeView x:Name="UsageTree"
                                      Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="7,6,7,8"
                                      ItemContainerStyle="{StaticResource StorageTreeItemStyle}"
                                      SelectedItemChanged="UsageTree_SelectedItemChanged"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"/>

                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <Border Style="{StaticResource PanelBorderStyle}"
                                    Padding="16"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock x:Name="SelectedTitleText"
                                               Text="Выберите папку или файл"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="SelectedPathText"
                                               Text=""
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <Border Height="1"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,10,0,10"
                                            Opacity="0.8"/>

                                    <TextBlock x:Name="SelectedDescriptionText"
                                               Text="Нажмите на строку слева, чтобы Thermiqra объяснила, что это и что с этим можно делать."
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               LineHeight="17"/>

                                    <Border x:Name="SafetyBorder"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                            Padding="11"
                                            Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="SafetyTitleText"
                                                       Text="Безопасность"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>

                                            <TextBlock x:Name="SafetyDescriptionText"
                                                       Text=""
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       LineHeight="16"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="DeleteButton"
                                                Grid.Column="0"
                                                Content="Удалить"
                                                IsEnabled="False"
                                                Click="DeleteButton_Click"/>

                                        <Button x:Name="OpenButton"
                                                Grid.Column="2"
                                                Content="Открыть"
                                                IsEnabled="False"
                                                Click="OpenButton_Click"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="ShowExplorerButton"
                                                Grid.Column="0"
                                                Content="Показать в Проводнике"
                                                IsEnabled="False"
                                                Click="ShowExplorerButton_Click"/>

                                        <Button x:Name="CopyPathButton"
                                                Grid.Column="2"
                                                Content="Скопировать путь"
                                                IsEnabled="False"
                                                Click="CopyPathButton_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="DeleteStageHintText"
                                               Text="Выбранные файлы и папки можно отправить в Корзину или удалить безвозвратно."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}"
                                    Padding="14">

                                <StackPanel>
                                    <TextBlock x:Name="LargestFilesTitleText"
                                               Text="Крупнейшие файлы"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,0,0,7"/>

                                    <StackPanel x:Name="LargestFilesPanel"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Grid>

            <Border x:Name="ErrorCard"
                    Style="{StaticResource SummaryCardStyle}"
                    Visibility="Collapsed"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="ErrorTitleText"
                               Text="Не удалось выполнить анализ"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ErrorDescriptionText"
                               Text=""
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- =====================================================
             НИЖНЯЯ СТРОКА
             ===================================================== -->

        <Grid Grid.Row="2"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="Подготовка анализа..."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button x:Name="CancelButton"
                        Content="Отмена"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="Закрыть"
                        MinWidth="100"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>
