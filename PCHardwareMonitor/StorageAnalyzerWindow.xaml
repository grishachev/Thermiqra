<Window x:Class="PCHardwareMonitor.StorageAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra — Анализ диска"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="19"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SummaryCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource PanelCornerRadius}"/>
            <Setter Property="Padding"
                    Value="16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="14,7"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource GaugeTrackBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             ТЕМАТИЧЕСКАЯ ШАПКА
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <!-- CYBER TECH -->
            <Border Visibility="{DynamicResource CyberTechVisibility}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="52"
                              Height="52"
                              Margin="0,0,16,0">
                            <Border BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Border Width="32"
                                    Height="20"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Border Width="22"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="DRV"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CyberMetaText"
                                       Text="THERMIQRA / STORAGE DIAGNOSTICS"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="CyberTitleText"
                                       Text="АНАЛИЗ ДИСКА"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>

                            <TextBlock x:Name="CyberSubtitleText"
                                       Text="Быстрый анализ занятого места"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="CyberDriveCaptionText"
                                           Text="TARGET DRIVE"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="CyberDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- STEAMPUNK -->
            <Border Visibility="{DynamicResource SteamPunkVisibility}"
                    Background="{DynamicResource SteamPanelBrush}"
                    BorderBrush="{DynamicResource SteamMetalBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Ellipse Stroke="{DynamicResource SteamMetalBrush}"
                                     StrokeThickness="3"
                                     Fill="{DynamicResource SteamGlassBrush}"/>
                            <Ellipse Width="40"
                                     Height="40"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1"/>
                            <Border Width="38"
                                    Height="5"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Ellipse Width="18"
                                     Height="18"
                                     Fill="{DynamicResource SteamDarkMetalBrush}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2"/>
                            <TextBlock Text="D"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SteamMetaText"
                                       Text="THERMIQRA / МЕХАНИЧЕСКИЙ АНАЛИЗ НАКОПИТЕЛЯ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="SteamTitleText"
                                       Text="АНАЛИЗ ДИСКА"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="SteamSubtitleText"
                                       Text="Ведомость распределения занятого места"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource SteamGlassBrush}"
                                BorderBrush="{DynamicResource SteamMetalBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="SteamDriveCaptionText"
                                           Text="НАКОПИТЕЛЬ"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="SteamDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SteamMetalBrush}"/>
                </Grid>
            </Border>

            <!-- FROST CORE -->
            <Border Visibility="{DynamicResource FrostCoreVisibility}"
                    Background="{DynamicResource FrostPanelBrush}"
                    BorderBrush="{DynamicResource FrostSteelBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource FrostIceBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Border BorderBrush="{DynamicResource FrostSteelBrush}"
                                    BorderThickness="2"
                                    CornerRadius="18"
                                    Background="{DynamicResource FrostGlassBrush}"/>
                            <Ellipse Width="38"
                                     Height="38"
                                     Stroke="{DynamicResource FrostIceBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.8"/>
                            <TextBlock Text="❄"
                                       Foreground="{DynamicResource FrostIceBrush}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="FrostMetaText"
                                       Text="THERMIQRA / CRYO STORAGE ANALYSIS"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="FrostTitleText"
                                       Text="АНАЛИЗ ДИСКА"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="FrostSubtitleText"
                                       Text="Криогенная карта занятого пространства"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource FrostGlassBrush}"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="FrostDriveCaptionText"
                                           Text="STORAGE NODE"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="FrostDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource FrostIceBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- MILITARY OPS -->
            <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                    Background="{DynamicResource MilitaryPanelBrush}"
                    BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">
                            <Ellipse Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="2"
                                     Fill="{DynamicResource MilitaryPlateBrush}"/>
                            <Ellipse Width="34"
                                     Height="34"
                                     Stroke="{DynamicResource MilitaryGridBrush}"
                                     StrokeThickness="1"/>
                            <Border Width="1"
                                    Height="48"
                                    Background="{DynamicResource MilitaryGridBrush}"/>
                            <Border Width="48"
                                    Height="1"
                                    Background="{DynamicResource MilitaryGridBrush}"/>
                            <TextBlock Text="D"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="MilitaryMetaText"
                                       Text="THERMIQRA / TACTICAL STORAGE INTEL"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="MilitaryTitleText"
                                       Text="АНАЛИЗ ДИСКА"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="MilitarySubtitleText"
                                       Text="Тактическая сводка распределения данных"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource MilitaryPlateBrush}"
                                BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="MilitaryDriveCaptionText"
                                           Text="TARGET"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MilitaryDriveText"
                                           Text="C:\"
                                           Foreground="{DynamicResource MilitaryKhakiBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource MilitaryKhakiBrush}"/>
                </Grid>
            </Border>

        </Grid>

        <!-- =====================================================
             СОДЕРЖИМОЕ
             ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <Border x:Name="LoadingCard"
                        Style="{StaticResource SummaryCardStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LoadingTitleText"
                                       Text="Анализ диска..."
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="LoadingDescriptionText"
                                       Text="Thermiqra читает структуру NTFS. Главное окно продолжает работать."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="SummaryGrid"
                      Visibility="Collapsed"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SummaryCardStyle}"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalCaptionText"
                                       Text="ВСЕГО"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="TotalValueText"
                                       Text="—"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SummaryCardStyle}"
                            Margin="4,0">
                        <StackPanel>
                            <TextBlock x:Name="UsedCaptionText"
                                       Text="ЗАНЯТО"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="UsedValueText"
                                       Text="—"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SummaryCardStyle}"
                            Margin="4,0">
                        <StackPanel>
                            <TextBlock x:Name="FreeCaptionText"
                                       Text="СВОБОДНО"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="FreeValueText"
                                       Text="—"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource SummaryCardStyle}"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ScanTimeCaptionText"
                                       Text="АНАЛИЗ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="ScanTimeValueText"
                                       Text="—"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="ResultsPanel"
                            Visibility="Collapsed">

                    <TextBlock x:Name="RootFoldersTitleText"
                               Text="Где занято место"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel x:Name="RootFoldersPanel"
                                Margin="0,0,0,20"/>

                    <TextBlock x:Name="RecommendationsTitleText"
                               Text="Рекомендации"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel x:Name="RecommendationsPanel"
                                Margin="0,0,0,20"/>

                    <TextBlock x:Name="LargestFoldersTitleText"
                               Text="Крупнейшие папки"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel x:Name="LargestFoldersPanel"
                                Margin="0,0,0,20"/>

                    <TextBlock x:Name="LargestFilesTitleText"
                               Text="Крупнейшие файлы"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel x:Name="LargestFilesPanel"
                                Margin="0,0,0,6"/>

                </StackPanel>

                <Border x:Name="ErrorCard"
                        Style="{StaticResource SummaryCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="ErrorTitleText"
                                   Text="Не удалось выполнить анализ"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ErrorDescriptionText"
                                   Text=""
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- =====================================================
             НИЖНЯЯ СТРОКА
             ===================================================== -->

        <Grid Grid.Row="2"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="Подготовка анализа..."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button x:Name="CancelButton"
                        Content="Отмена"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="Закрыть"
                        MinWidth="100"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>
