<Window x:Class="PCHardwareMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Настройки — Thermiqra"
        Width="760"
        Height="880"
        MinWidth="650"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ОБЩИЙ ТЕКСТ                                           -->
        <!-- ===================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="TechLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="9"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
        </Style>


        <!-- ===================================================== -->
        <!-- TEXTBOX                                               -->
        <!-- ===================================================== -->

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Background"
                    Value="{DynamicResource SettingsInputBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsCardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,6"/>

            <Setter Property="Margin"
                    Value="0,5,0,8"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{DynamicResource AccentBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="{DynamicResource AccentBrush}"/>

            <Style.Triggers>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX CYBER                                        -->
        <!-- ===================================================== -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,6,0,6"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">

                                <Path x:Name="CheckMark"
                                      Data="M 3 7 L 6 10 L 13 3"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX                                              -->
        <!-- ===================================================== -->

        <Style x:Key="ThemedComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ThemedComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Background"
                    Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{DynamicResource SettingsInputBrush}"
                                                BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Margin="10,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem,
                                                                                    RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  TextElement.Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource AccentBrush}"
                                                          Data="M 0 0 L 8 0 L 4 5 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Width="{TemplateBinding ActualWidth}"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource SettingsInputBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- SCROLLBAR                                             -->
        <!-- ===================================================== -->

        <Style x:Key="CyberScrollThumbStyle"
               TargetType="{x:Type primitives:Thumb}">

            <Setter Property="Background"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">

                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Margin="2,0"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="InvisibleScrollButtonStyle"
               TargetType="{x:Type RepeatButton}">

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="IsTabStop"
                    Value="False"/>

            <Setter Property="Opacity"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style TargetType="{x:Type ScrollBar}">

            <Setter Property="Width"
                    Value="11"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Background="Transparent">

                            <primitives:Track x:Name="PART_Track"
                                              IsDirectionReversed="True">

                                <primitives:Track.DecreaseRepeatButton>

                                    <RepeatButton Style="{StaticResource InvisibleScrollButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand"/>

                                </primitives:Track.DecreaseRepeatButton>

                                <primitives:Track.Thumb>

                                    <primitives:Thumb Style="{StaticResource CyberScrollThumbStyle}"
                                                      MinHeight="34"/>

                                </primitives:Track.Thumb>

                                <primitives:Track.IncreaseRepeatButton>

                                    <RepeatButton Style="{StaticResource InvisibleScrollButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand"/>

                                </primitives:Track.IncreaseRepeatButton>

                            </primitives:Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BUTTON                                                -->
        <!-- ===================================================== -->

        <Style TargetType="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource SettingsCardBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsCardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="14,6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SettingsInputBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- КАРТОЧКА СЕКЦИИ                                       -->
        <!-- ===================================================== -->

        <Style x:Key="TechCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource SettingsCardBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsCardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="{DynamicResource PanelCornerRadius}"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

        </Style>


        <!-- ===================================================== -->
        <!-- STEAMPUNK DECOR                                       -->
        <!-- ===================================================== -->

        <Style x:Key="SteamRivetStyle"
               TargetType="Ellipse">
            <Setter Property="Width"
                    Value="7"/>
            <Setter Property="Height"
                    Value="7"/>
            <Setter Property="Fill"
                    Value="{DynamicResource SteamRivetBrush}"/>
            <Setter Property="Stroke"
                    Value="{DynamicResource SteamDarkMetalBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="1"/>
            <Setter Property="Margin"
                    Value="8"/>
            <Setter Property="IsHitTestVisible"
                    Value="False"/>
            <Setter Property="Visibility"
                    Value="{DynamicResource SteamPunkVisibility}"/>
        </Style>

        <Style x:Key="SteamPlateTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="8"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
        </Style>

        <!-- ===================================================== -->
        <!-- FROST CORE / MILITARY OPS DECOR                      -->
        <!-- ===================================================== -->

        <Style x:Key="FrostSectionFrameStyle"
               TargetType="Border">
            <Setter Property="Visibility"
                    Value="{DynamicResource FrostCoreVisibility}"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource FrostSteelBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Opacity"
                    Value="0.72"/>
            <Setter Property="IsHitTestVisible"
                    Value="False"/>
        </Style>

        <Style x:Key="MilitarySectionFrameStyle"
               TargetType="Border">
            <Setter Property="Visibility"
                    Value="{DynamicResource MilitaryOpsVisibility}"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource MilitaryKhakiBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="1"/>
            <Setter Property="Opacity"
                    Value="0.78"/>
            <Setter Property="IsHitTestVisible"
                    Value="False"/>
        </Style>

        <Style x:Key="FrostTopStripStyle"
               TargetType="Border">
            <Setter Property="Visibility"
                    Value="{DynamicResource FrostCoreVisibility}"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="22,0,0,0"/>
            <Setter Property="CornerRadius" Value="0,0,4,4"/>
            <Setter Property="Background"
                    Value="{DynamicResource FrostIceBrush}"/>
            <Setter Property="Opacity" Value="0.86"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="MilitaryTopStripStyle"
               TargetType="Border">
            <Setter Property="Visibility"
                    Value="{DynamicResource MilitaryOpsVisibility}"/>
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="18,0,0,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource MilitaryKhakiBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </Window.Resources>


    <Grid>

        <!-- Frost Core: холодная лабораторная подложка -->
        <Rectangle Visibility="{DynamicResource FrostCoreVisibility}"
                   IsHitTestVisible="False"
                   Opacity="0.09">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,64,64"
                              ViewportUnits="Absolute"
                              Viewbox="0,0,64,64"
                              ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{DynamicResource FrostSteelBrush}"
                                     Thickness="0.7"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="64,0"/>
                                    <LineGeometry StartPoint="0,32" EndPoint="64,32"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,64"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Military Ops: статичный цифровой камуфляж фона -->
        <Rectangle Visibility="{DynamicResource MilitaryOpsVisibility}"
                   Fill="{DynamicResource MilitaryPanelBrush}"
                   Opacity="0.16"
                   IsHitTestVisible="False"/>

        <!-- ===================================================== -->
        <!-- СЛАБАЯ HUD-СЕТКА                                      -->
        <!-- ===================================================== -->

        <Rectangle IsHitTestVisible="False"
                   Visibility="{DynamicResource CyberTechVisibility}"
                   Opacity="0.10">

            <Rectangle.Fill>

                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,32,32"
                              ViewportUnits="Absolute"
                              Viewbox="0,0,32,32"
                              ViewboxUnits="Absolute">

                    <DrawingBrush.Drawing>

                        <GeometryDrawing>

                            <GeometryDrawing.Pen>

                                <Pen Brush="{DynamicResource BorderBrush}"
                                     Thickness="0.55"/>

                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>

                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0"
                                                  EndPoint="32,0"/>
                                    <LineGeometry StartPoint="0,0"
                                                  EndPoint="0,32"/>
                                </GeometryGroup>

                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                    </DrawingBrush.Drawing>

                </DrawingBrush>

            </Rectangle.Fill>

        </Rectangle>

        <!-- Статические латунные направляющие фона SteamPunk -->
        <Border Visibility="{DynamicResource SteamPunkVisibility}"
                Width="3"
                HorizontalAlignment="Left"
                Margin="8,18,0,18"
                Background="{DynamicResource SteamMetalBrush}"
                Opacity="0.55"
                IsHitTestVisible="False"/>

        <Border Visibility="{DynamicResource SteamPunkVisibility}"
                Width="3"
                HorizontalAlignment="Right"
                Margin="0,18,8,18"
                Background="{DynamicResource SteamMetalBrush}"
                Opacity="0.55"
                IsHitTestVisible="False"/>


        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource SettingsCardBrush}"
                    BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Width="170"
                            Height="3"
                            HorizontalAlignment="Left"
                            Margin="18,0,0,0"
                            Background="{DynamicResource AccentBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,13,18,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <Grid Width="38"
                              Height="38">

                            <Border BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>

                            <Border Width="18"
                                    Height="18"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Border Width="5"
                                    Height="5"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                        </Grid>


                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="1,2,0,0">

                                <TextBlock Text="НАСТРОЙКИ СИСТЕМЫ"
                                           Style="{StaticResource TechLabelStyle}"/>

                                <Border Width="30"
                                        Height="1"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="9,0"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ"
                                           Style="{StaticResource TechLabelStyle}"/>

                            </StackPanel>

                        </StackPanel>


                        <StackPanel Grid.Column="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="НАСТРОЙКИ"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="ЛОКАЛЬНЫЙ ПРОФИЛЬ"
                                       Style="{StaticResource TechLabelStyle}"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Grid>

                    <!-- Отдельная шапка SteamPunk поверх Cyber Tech -->
                    <Grid Grid.RowSpan="2"
                          Visibility="{DynamicResource SteamPunkVisibility}"
                          Background="{DynamicResource SteamPanelBrush}">

                        <Border Margin="5"
                                BorderBrush="{DynamicResource SteamMetalBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"/>

                        <Ellipse Style="{StaticResource SteamRivetStyle}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"/>
                        <Ellipse Style="{StaticResource SteamRivetStyle}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"/>
                        <Ellipse Style="{StaticResource SteamRivetStyle}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"/>
                        <Ellipse Style="{StaticResource SteamRivetStyle}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"/>

                        <Grid Margin="18,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="46"
                                  Height="46"
                                  VerticalAlignment="Center">

                                <Ellipse Fill="{DynamicResource SteamGlassBrush}"
                                         Stroke="{DynamicResource SteamMetalBrush}"
                                         StrokeThickness="3"/>

                                <Ellipse Width="29"
                                         Height="29"
                                         Stroke="{DynamicResource BorderBrush}"
                                         StrokeThickness="1"/>

                                <TextBlock Text="⚙"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="25"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">

                                <TextBlock Text="THERMIQRA"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="22"
                                           FontWeight="Bold"/>

                                <TextBlock Text="МЕХАНИЧЕСКАЯ ПАНЕЛЬ НАСТРОЕК"
                                           Style="{StaticResource SteamPlateTextStyle}"
                                           Margin="1,2,0,0"/>

                            </StackPanel>

                            <Border Grid.Column="3"
                                    Background="{DynamicResource SteamGlassBrush}"
                                    BorderBrush="{DynamicResource SteamMetalBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="12,7"
                                    VerticalAlignment="Center">

                                <StackPanel>

                                    <TextBlock Text="КОНФИГУРАЦИЯ"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="ЛОКАЛЬНЫЙ ПРОФИЛЬ"
                                               Style="{StaticResource SteamPlateTextStyle}"
