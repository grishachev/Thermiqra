                                        <TextBlock Text="УВЕДОМЛЕНИЯ"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="ALERT CONTROL / CRITICAL EVENTS"
                                                   Style="{StaticResource TechLabelStyle}"
                                                   Margin="1,2,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="03"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Opacity="0.75"/>

                                </Grid>


                                <CheckBox x:Name="NotificationsCheck"
                                          Content="Показывать уведомления"/>


                                <Grid Margin="0,6,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Задержка первого предупреждения"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBlock Text="СЕКУНДЫ"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="8"
                                                   Margin="0,2,0,0"/>

                                        <TextBox x:Name="AlertDelayText"/>

                                    </StackPanel>


                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Повтор критического предупреждения"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBlock Text="МИНУТЫ"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="8"
                                                   Margin="0,2,0,0"/>

                                        <TextBox x:Name="CriticalRepeatMinutesText"/>

                                    </StackPanel>

                                </Grid>


                                <CheckBox x:Name="RepeatCriticalAlertsCheck"
                                          Content="Повторять критические температурные предупреждения"/>


                                <TextBlock Text="Повтор применяется только к критической температуре CPU, GPU и накопителей. Предупреждения о заполнении диска не повторяются."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ========================================= -->
                    <!-- CPU / GPU                                  -->
                    <!-- ========================================= -->

                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- CPU -->

                        <Border Grid.Column="0"
                                Style="{StaticResource TechCardStyle}"
                                Margin="0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.RowSpan="10"
                                        Visibility="{DynamicResource SteamPunkVisibility}"
                                        Margin="4"
                                        BorderBrush="{DynamicResource SteamMetalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"/>


                                <Border Grid.RowSpan="10"
                                        Style="{StaticResource FrostSectionFrameStyle}"/>

                                <Border Grid.RowSpan="10"
                                        Style="{StaticResource MilitarySectionFrameStyle}"/>

                                <TextBlock Grid.RowSpan="10"
                                           Visibility="{DynamicResource FrostCoreVisibility}"
                                           Text="❄"
                                           Foreground="{DynamicResource FrostIceBrush}"
                                           FontSize="44"
                                           Opacity="0.05"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,18,0"
                                           IsHitTestVisible="False"/>

                                <Grid Grid.RowSpan="10"
                                      Visibility="{DynamicResource MilitaryOpsVisibility}"
                                      Width="48"
                                      Height="28"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,8,9,0"
                                      Opacity="0.32"
                                      IsHitTestVisible="False">
                                    <Border Width="1" Height="26"
                                            Background="{DynamicResource MilitaryGridBrush}"
                                            HorizontalAlignment="Center"/>
                                    <Border Width="46" Height="1"
                                            Background="{DynamicResource MilitaryGridBrush}"
                                            VerticalAlignment="Center"/>
                                    <Ellipse Width="12" Height="12"
                                             Stroke="{DynamicResource MilitaryKhakiBrush}"
                                             StrokeThickness="1"/>
                                </Grid>

                                <Border Style="{StaticResource FrostTopStripStyle}"/>
                                <Border Style="{StaticResource MilitaryTopStripStyle}"/>

                                <Border Width="82"
                                        Height="3"
                                        Visibility="{DynamicResource CyberTechVisibility}"
                                        HorizontalAlignment="Left"
                                        Margin="18,0,0,0"
                                        Background="{DynamicResource AccentBrush}"/>

                                <StackPanel Grid.Row="1"
                                            Margin="18,14,18,18">

                                    <Grid Margin="0,0,0,9">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="CPU"
                                                       Style="{StaticResource SectionTitleStyle}"/>

                                            <TextBlock Text="ТЕМПЕРАТУРНЫЕ ПОРОГИ"
                                                       Style="{StaticResource TechLabelStyle}"
                                                       Margin="1,2,0,0"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="04"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Opacity="0.75"/>

                                    </Grid>


                                    <CheckBox x:Name="CpuNotificationsCheck"
                                              Content="Контроль температуры CPU"/>


                                    <TextBlock Text="ПРЕДУПРЕЖДЕНИЕ, °C"
                                               Style="{StaticResource TechLabelStyle}"
                                               Margin="0,7,0,0"/>

                                    <TextBox x:Name="CpuWarningText"/>


                                    <TextBlock Text="КРИТИЧЕСКАЯ, °C"
                                               Style="{StaticResource TechLabelStyle}"/>

                                    <TextBox x:Name="CpuCriticalText"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- GPU -->

                        <Border Grid.Column="2"
                                Style="{StaticResource TechCardStyle}"
                                Margin="0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.RowSpan="10"
                                        Visibility="{DynamicResource SteamPunkVisibility}"
                                        Margin="4"
                                        BorderBrush="{DynamicResource SteamMetalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"/>

                                <Ellipse Grid.RowSpan="10"
                                         Style="{StaticResource SteamRivetStyle}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"/>


                                <Border Grid.RowSpan="10"
                                        Style="{StaticResource FrostSectionFrameStyle}"/>

                                <Border Grid.RowSpan="10"
                                        Style="{StaticResource MilitarySectionFrameStyle}"/>

                                <TextBlock Grid.RowSpan="10"
                                           Visibility="{DynamicResource FrostCoreVisibility}"
                                           Text="❄"
                                           Foreground="{DynamicResource FrostIceBrush}"
                                           FontSize="44"
                                           Opacity="0.05"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,18,0"
                                           IsHitTestVisible="False"/>

                                <Grid Grid.RowSpan="10"
                                      Visibility="{DynamicResource MilitaryOpsVisibility}"
                                      Width="48"
                                      Height="28"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,8,9,0"
                                      Opacity="0.32"
                                      IsHitTestVisible="False">
                                    <Border Width="1" Height="26"
                                            Background="{DynamicResource MilitaryGridBrush}"
                                            HorizontalAlignment="Center"/>
                                    <Border Width="46" Height="1"
                                            Background="{DynamicResource MilitaryGridBrush}"
                                            VerticalAlignment="Center"/>
                                    <Ellipse Width="12" Height="12"
                                             Stroke="{DynamicResource MilitaryKhakiBrush}"
                                             StrokeThickness="1"/>
                                </Grid>

                                <Border Style="{StaticResource FrostTopStripStyle}"/>
                                <Border Style="{StaticResource MilitaryTopStripStyle}"/>

                                <Border Width="82"
                                        Height="3"
                                        Visibility="{DynamicResource CyberTechVisibility}"
                                        HorizontalAlignment="Left"
                                        Margin="18,0,0,0"
                                        Background="{DynamicResource AccentBrush}"/>

                                <StackPanel Grid.Row="1"
                                            Margin="18,14,18,18">

                                    <Grid Margin="0,0,0,9">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="GPU"
                                                       Style="{StaticResource SectionTitleStyle}"/>

                                            <TextBlock Text="ТЕМПЕРАТУРНЫЕ ПОРОГИ"
                                                       Style="{StaticResource TechLabelStyle}"
                                                       Margin="1,2,0,0"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="05"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Opacity="0.75"/>

                                    </Grid>


                                    <CheckBox x:Name="GpuNotificationsCheck"
                                              Content="Контроль температуры GPU"/>


                                    <TextBlock Text="ПРЕДУПРЕЖДЕНИЕ, °C"
                                               Style="{StaticResource TechLabelStyle}"
                                               Margin="0,7,0,0"/>

                                    <TextBox x:Name="GpuWarningText"/>


                                    <TextBlock Text="КРИТИЧЕСКАЯ, °C"
                                               Style="{StaticResource TechLabelStyle}"/>

                                    <TextBox x:Name="GpuCriticalText"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- НАКОПИТЕЛИ                                 -->
                    <!-- ========================================= -->

                    <Border Style="{StaticResource TechCardStyle}"
                            Margin="0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="10"
                                    Visibility="{DynamicResource SteamPunkVisibility}"
                                    Margin="4"
                                    BorderBrush="{DynamicResource SteamMetalBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsHitTestVisible="False"/>

                            <Ellipse Grid.RowSpan="10"
                                     Style="{StaticResource SteamRivetStyle}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>

                            <Ellipse Grid.RowSpan="10"
                                     Style="{StaticResource SteamRivetStyle}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"/>

                            <Ellipse Grid.RowSpan="10"
                                     Style="{StaticResource SteamRivetStyle}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"/>

                            <Ellipse Grid.RowSpan="10"
                                     Style="{StaticResource SteamRivetStyle}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"/>


                            <Border Grid.RowSpan="10"
                                    Style="{StaticResource FrostSectionFrameStyle}"/>

                            <Border Grid.RowSpan="10"
                                    Style="{StaticResource MilitarySectionFrameStyle}"/>

                            <TextBlock Grid.RowSpan="10"
                                       Visibility="{DynamicResource FrostCoreVisibility}"
                                       Text="❄"
                                       Foreground="{DynamicResource FrostIceBrush}"
                                       FontSize="48"
                                       Opacity="0.055"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,22,0"
                                       IsHitTestVisible="False"/>

                            <Grid Grid.RowSpan="10"
                                  Visibility="{DynamicResource MilitaryOpsVisibility}"
                                  Width="54"
                                  Height="30"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0,8,10,0"
                                  Opacity="0.34"
                                  IsHitTestVisible="False">
                                <Border Width="1" Height="28"
                                        Background="{DynamicResource MilitaryGridBrush}"
                                        HorizontalAlignment="Center"/>
                                <Border Width="52" Height="1"
                                        Background="{DynamicResource MilitaryGridBrush}"
                                        VerticalAlignment="Center"/>
                                <Ellipse Width="13" Height="13"
                                         Stroke="{DynamicResource MilitaryKhakiBrush}"
                                         StrokeThickness="1"/>
                            </Grid>

                            <Border Style="{StaticResource FrostTopStripStyle}"/>
                            <Border Style="{StaticResource MilitaryTopStripStyle}"/>

                            <Border Width="105"
                                    Height="3"
                                    Visibility="{DynamicResource CyberTechVisibility}"
                                    HorizontalAlignment="Left"
                                    Margin="18,0,0,0"
                                    Background="{DynamicResource AccentBrush}"/>

                            <StackPanel Grid.Row="1"
                                        Margin="18,14,18,18">

                                <Grid Margin="0,0,0,9">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="НАКОПИТЕЛИ"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="ТЕМПЕРАТУРА И ЗАПОЛНЕНИЕ ДИСКОВ"
                                                   Style="{StaticResource TechLabelStyle}"
                                                   Margin="1,2,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="06"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Opacity="0.75"/>

                                </Grid>


                                <CheckBox x:Name="StorageTemperatureNotificationsCheck"
                                          Content="Контроль температуры накопителей"/>


                                <Grid Margin="0,6,0,5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="ПРЕДУПРЕЖДЕНИЕ, °C"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBox x:Name="StorageWarningText"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="КРИТИЧЕСКАЯ, °C"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBox x:Name="StorageCriticalText"/>

                                    </StackPanel>

                                </Grid>


                                <Border Height="1"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,6,0,10"/>


                                <CheckBox x:Name="DiskSpaceNotificationsCheck"
                                          Content="Контроль свободного места на дисках"/>


                                <Grid Margin="0,6,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="ПРЕДУПРЕЖДЕНИЕ, %"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBox x:Name="DiskWarningText"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="КРИТИЧЕСКОЕ, %"
                                                   Style="{StaticResource TechLabelStyle}"/>

                                        <TextBox x:Name="DiskCriticalText"/>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- НИЖНЯЯ ПАНЕЛЬ                                     -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{DynamicResource SettingsCardBrush}"
                    BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Margin="0,14,0,0">

                <Grid>

                    <Border Visibility="{DynamicResource SteamPunkVisibility}"
                            Margin="4"
                            BorderBrush="{DynamicResource SteamMetalBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False"/>

                    <Ellipse Style="{StaticResource SteamRivetStyle}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"/>
                    <Ellipse Style="{StaticResource SteamRivetStyle}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"/>
                    <Ellipse Style="{StaticResource SteamRivetStyle}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"/>
                    <Ellipse Style="{StaticResource SteamRivetStyle}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"/>

                    <Border Style="{StaticResource FrostSectionFrameStyle}"/>
                    <Border Style="{StaticResource MilitarySectionFrameStyle}"/>
                    <Border Style="{StaticResource FrostTopStripStyle}"/>
                    <Border Style="{StaticResource MilitaryTopStripStyle}"/>

                    <Grid Margin="14,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="THERMIQRA // НАСТРОЙКИ"
                                   Style="{StaticResource TechLabelStyle}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,3,0,0">

                            <Border Width="26"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="ЛОКАЛЬНЫЕ ПАРАМЕТРЫ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Content="ОТМЕНА"
                            Width="108"
                            Click="Cancel_Click"/>


                    <Button Grid.Column="3"
                            Content="СОХРАНИТЬ"
                            Width="126"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentBrush}"
                            Click="Save_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
