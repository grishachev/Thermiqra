<Window x:Class="PCHardwareMonitor.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Thermiqra — Информация о системе"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin"
                    Value="0,0,0,16"/>
        </Style>

        <Style x:Key="InfoLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="InfoValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="LineHeight"
                    Value="20"/>
            <Setter Property="LineStackingStrategy"
                    Value="BlockLineHeight"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="InfoCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource PanelCornerRadius}"/>
            <Setter Property="Padding"
                    Value="18"/>
            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CyberMetaStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="8"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemInfoTabForegroundBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource SystemInfoTabBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SystemInfoTabBorderBrush}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource SystemInfoTabPadding}"/>
            <Setter Property="Margin"
                    Value="0,0,6,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="{TemplateBinding Margin}">

                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SystemInfoTabCornerRadius}">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.FontFamily="{DynamicResource SystemInfoTabFontFamily}"
                                                  TextElement.FontSize="{DynamicResource SystemInfoTabFontSize}"
                                                  TextElement.FontWeight="{DynamicResource SystemInfoTabFontWeight}"
                                                  RecognizesAccessKey="True"/>
                            </Border>

                            <Border x:Name="AccentBorder"
                                    BorderBrush="{DynamicResource SystemInfoTabSelectedBorderBrush}"
                                    BorderThickness="{DynamicResource SystemInfoTabAccentThickness}"
                                    CornerRadius="{DynamicResource SystemInfoTabCornerRadius}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource WindowBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource SystemInfoTabSelectedBackgroundBrush}"/>
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SystemInfoTabSelectedBorderBrush}"/>
                                <Setter TargetName="AccentBorder"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SystemInfoTabSelectedForegroundBrush}"/>
                                <Setter Property="Panel.ZIndex"
                                        Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="HeaderBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="18,8"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource WindowBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource GaugeTrackBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================
             ТЕМАТИЧЕСКАЯ ПОЛОСА ПРОКРУТКИ
             ===================================================== -->

        <Style x:Key="SystemInfoScrollThumbStyle"
               TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Background"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SystemInfoInvisibleScrollButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="IsTabStop"
                    Value="False"/>
            <Setter Property="Opacity"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width"
                    Value="11"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <primitives:Track x:Name="PART_Track"
                                              IsDirectionReversed="True">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SystemInfoInvisibleScrollButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </primitives:Track.DecreaseRepeatButton>

                                <primitives:Track.Thumb>
                                    <primitives:Thumb Style="{StaticResource SystemInfoScrollThumbStyle}"
                                                      MinHeight="34"/>
                                </primitives:Track.Thumb>

                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SystemInfoInvisibleScrollButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <!-- CYBER TECH -->
            <Border Visibility="{DynamicResource CyberTechVisibility}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,14,18,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="52"
                              Height="52"
                              Margin="0,0,16,0">

                            <Border BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>

                            <Border Width="28"
                                    Height="28"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Border Width="16"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,10,0,0"/>

                            <Border Width="16"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="SYS"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="THERMIQRA"
                                           Style="{StaticResource CyberMetaStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>

                                <TextBlock Text="  /  SYSTEM DIAGNOSTICS"
                                           Style="{StaticResource CyberMetaStyle}"/>
                            </StackPanel>

                            <TextBlock Text="ИНФОРМАЦИЯ О СИСТЕМЕ"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,2,0,0"/>

                            <TextBlock Text="Аппаратный паспорт и статическая диагностика конфигурации"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <StackPanel>
                                <TextBlock Text="HOST NODE"
                                           Style="{StaticResource CyberMetaStyle}"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="CyberHeaderComputerNameText"
                                           Text="Компьютер"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="STATUS: ONLINE"
                                           Style="{StaticResource CyberMetaStyle}"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </Border>

            <!-- ОСТАЛЬНЫЕ СКИНЫ: пока сохраняем текущую универсальную шапку -->
            <Border Visibility="{DynamicResource SteamPunkVisibility}"
                    Background="{DynamicResource SteamPanelBrush}"
                    BorderBrush="{DynamicResource SteamMetalBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">

                            <Ellipse Stroke="{DynamicResource SteamMetalBrush}"
                                     StrokeThickness="3"
                                     Fill="{DynamicResource SteamGlassBrush}"/>

                            <Ellipse Width="40"
                                     Height="40"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1"/>

                            <Border Width="4"
                                    Height="38"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Border Width="38"
                                    Height="4"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Ellipse Width="18"
                                     Height="18"
                                     Fill="{DynamicResource SteamDarkMetalBrush}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2"/>

                            <TextBlock Text="S"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA / МЕХАНИЧЕСКИЙ ПАСПОРТ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock Text="ИНФОРМАЦИЯ О СИСТЕМЕ"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,3,0,0"/>

                            <TextBlock Text="Техническая ведомость аппаратных узлов"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource SteamGlassBrush}"
                                BorderBrush="{DynamicResource SteamMetalBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <StackPanel>
                                <TextBlock Text="МАШИННЫЙ УЗЕЛ"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="SteamHeaderComputerNameText"
                                           Text="Компьютер"
                                               Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="СОСТОЯНИЕ: ГОТОВ"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SteamMetalBrush}"/>
                </Grid>
            </Border>

            <Border Visibility="{DynamicResource FrostCoreVisibility}"
                    Background="{DynamicResource FrostPanelBrush}"
                    BorderBrush="{DynamicResource FrostSteelBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource FrostIceBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="18,14,18,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">

                            <Border BorderBrush="{DynamicResource FrostSteelBrush}"
                                    BorderThickness="2"
                                    CornerRadius="18"
                                    Background="{DynamicResource FrostGlassBrush}"/>

                            <Ellipse Width="38"
                                     Height="38"
                                     Stroke="{DynamicResource FrostIceBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.8"/>

                            <TextBlock Text="❄"
                                       Foreground="{DynamicResource FrostIceBrush}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{DynamicResource AccentBrush}"
                                     Stroke="{DynamicResource FrostGlassBrush}"
                                     StrokeThickness="1"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA / CRYO SYSTEM ANALYSIS"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock Text="ИНФОРМАЦИЯ О СИСТЕМЕ"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,3,0,0"/>

                            <TextBlock Text="Криогенная диагностика аппаратной конфигурации"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource FrostGlassBrush}"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <StackPanel>
                                <TextBlock Text="CRYO NODE"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="FrostHeaderComputerNameText"
                                           Text="Компьютер"
                                           Foreground="{DynamicResource FrostIceBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="КОНТУР: СТАБИЛЕН"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                    Background="{DynamicResource MilitaryPanelBrush}"
                    BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="58"
                              Height="58"
                              Margin="0,0,16,0">

                            <Ellipse Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="2"
                                     Fill="{DynamicResource MilitaryPlateBrush}"/>

                            <Ellipse Width="34"
                                     Height="34"
                                     Stroke="{DynamicResource MilitaryGridBrush}"
                                     StrokeThickness="1"/>

                            <Border Width="1"
                                    Height="48"
                                    Background="{DynamicResource MilitaryGridBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Border Width="48"
                                    Height="1"
                                    Background="{DynamicResource MilitaryGridBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{DynamicResource AccentBrush}"
                                     Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="1"/>

                            <TextBlock Text="N"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="THERMIQRA / TACTICAL HARDWARE INTEL"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       Foreground="{DynamicResource MilitaryKhakiBrush}"
                                       FontSize="8"
                                       FontWeight="Bold"/>

                            <TextBlock Text="ИНФОРМАЦИЯ О СИСТЕМЕ"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,3,0,0"/>

                            <TextBlock Text="Тактический аппаратный паспорт и системная сводка"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource MilitaryPlateBrush}"
                                BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource MiniCardCornerRadius}"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <StackPanel>
                                <TextBlock Text="ОБЪЕКТ / HOST"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           Foreground="{DynamicResource MilitaryKhakiBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="MilitaryHeaderComputerNameText"
                                           Text="Компьютер"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="СТАТУС: В СЕТИ"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="8"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource MilitaryKhakiBrush}"/>
                </Grid>
            </Border>

        </Grid>

        <!-- ВКЛАДКИ -->
        <TabControl Grid.Row="1">

            <!-- =====================================================
                 ОБЗОР
                 ===================================================== -->
            <TabItem Header="ОБЗОР">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,18,6,0">

                        <TextBlock Text="Обзор системы"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Style="{StaticResource InfoCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
