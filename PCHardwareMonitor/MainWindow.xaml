<Window x:Class="PCHardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra"
        Width="1400"
        Height="820"
        MinWidth="520"
        MinHeight="500"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- =====================================================
             КНОПКИ
             ===================================================== -->

        <Style TargetType="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="MinHeight"
                    Value="38"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             PROGRESS BAR
             ===================================================== -->

        <Style TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="9"/>

            <Setter Property="Background"
                    Value="{DynamicResource GaugeTrackBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2">

                            <Grid ClipToBounds="True">

                                <Grid x:Name="PART_Track"/>

                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             ТЕКСТ
             ===================================================== -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>


        <Style x:Key="TechLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style x:Key="SecondaryTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

        </Style>


        <!-- =====================================================
             ПОЛОСА ПРОКРУТКИ
             ===================================================== -->

        <Style x:Key="ThermiqraScrollThumbStyle"
               TargetType="Thumb">

            <Setter Property="MinHeight"
                    Value="32"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource BorderBrush}"
                                CornerRadius="3"
                                Margin="2,1"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"
                                                  Focusable="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb Style="{StaticResource ThermiqraScrollThumbStyle}"/>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"
                                                  Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="22,20,22,16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- =================================================
                 ШАПКА
                 ================================================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Верхняя линия -->

                    <Grid Grid.Row="0">

                        <Border Width="170"
                                Height="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"/>

                    </Grid>


                    <Grid Grid.Row="1"
                          Margin="18,13,18,13">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Левый технический маркер -->

                        <Grid Grid.Column="0"
                              Width="34"
                              Height="44"
                              Margin="0,0,14,0">

                            <Border Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>

                            <Border Width="15"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="3,0,0,0"
                                    Background="{DynamicResource AccentBrush}"/>

                            <Border Width="9"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="3,0,0,0"
                                    Background="{DynamicResource BorderBrush}"/>

                        </Grid>


                        <!-- Название -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="THERMIQRA"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>


                                <Border Margin="12,2,0,0"
                                        Padding="8,3"
                                        CornerRadius="3"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse x:Name="LivePulseDot"
                                                 Width="6"
                                                 Height="6"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="LIVE"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>


                            <StackPanel Orientation="Horizontal"
                                        Margin="1,4,0,0">

                                <TextBlock Text="HARDWARE MONITORING SYSTEM"
                                           Style="{StaticResource TechLabelStyle}"
                                           VerticalAlignment="Center"/>

                                <Border Width="18"
                                        Height="1"
                                        Margin="10,0"
                                        Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center"/>

                                <TextBlock x:Name="StatusText"
                                           Text="Запуск мониторинга..."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- Настройки -->

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <StackPanel Margin="0,0,16,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="SYSTEM CONTROL"
                                           Style="{StaticResource TechLabelStyle}"
                                           HorizontalAlignment="Right"/>

                                <TextBlock Text="REAL-TIME"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <Button Content="⚙  Настройки"
                                    MinWidth="126"
                                    Click="SettingsButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!-- =================================================
                 CPU / GPU
                 ================================================= -->

            <WrapPanel x:Name="MainGaugesPanel"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>


            <!-- =================================================
                 RAM
                 ================================================= -->

            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Path Grid.RowSpan="2"
                          Data="M 8,0 L 100,0 L 100,88 L 96,100 L 0,100 L 0,8 Z"
                          Stretch="Fill"
                          Fill="{DynamicResource CardBackgroundBrush}"
                          Stroke="{DynamicResource BorderBrush}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"/>


                    <Grid Grid.Row="0">

                        <Border Width="82"
                                Height="3"
                                HorizontalAlignment="Left"
                                Margin="28,0,0,0"
                                Background="{DynamicResource AccentBrush}"/>

                    </Grid>


                    <Border Grid.RowSpan="2"
                            Width="36"
                            Height="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,30,0"
                            Background="{DynamicResource AccentBrush}"
                            Opacity="0.72"/>


                    <Grid Grid.Row="1"
                          Margin="18,13,18,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Значок -->

                        <Grid Grid.Column="0"
                              Width="50"
                              Height="50"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center">

                            <Border Width="34"
                                    Height="30"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Grid>

                                    <Border Margin="6"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Border Width="3"
                                                Height="12"
                                                Background="{DynamicResource AccentBrush}"
                                                Margin="1"/>

                                        <Border Width="3"
                                                Height="12"
                                                Background="{DynamicResource AccentBrush}"
                                                Margin="1"/>

                                        <Border Width="3"
                                                Height="12"
                                                Background="{DynamicResource AccentBrush}"
                                                Margin="1"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- Основная RAM -->

                        <Grid Grid.Column="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,6">

                                <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Border Width="22"
                                        Height="1"
                                        Margin="11,0"
                                        Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="MEMORY MODULE 03"
                                           Style="{StaticResource TechLabelStyle}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <TextBlock x:Name="RamText"
                                       Grid.Row="1"
                                       Text="Нет данных"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>


                            <ProgressBar x:Name="RamBar"
                                         Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="9"/>


                            <TextBlock x:Name="RamPercentText"
                                       Grid.Row="3"
                                       Text="-- %"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0"/>

                        </Grid>


                        <!-- Правая диагностическая метка -->

                        <StackPanel Grid.Column="2"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="STATUS"
                                       Style="{StaticResource TechLabelStyle}"
                                       HorizontalAlignment="Right"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">

                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource AccentBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="MEMORY LOAD"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!-- =================================================
                 НИЖНИЕ МОДУЛИ
                 ================================================= -->

            <StackPanel Grid.Row="3">


                <!-- =================================================
                     ДИСКИ — ЗАГОЛОВОК
                     ================================================= -->

                <Grid Margin="4,1,4,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="3"
                            Height="15"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,9,0"/>


                    <TextBlock Grid.Column="1"
                               Text="ДИСКИ"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"/>


                    <Border Grid.Column="2"
                            Height="1"
                            Margin="13,0,13,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>


                    <TextBlock Grid.Column="3"
                               Text="STORAGE VOLUME ARRAY"
                               Style="{StaticResource TechLabelStyle}"
                               VerticalAlignment="Center"/>

                </Grid>


                <Grid x:Name="DrivesPanel"/>


                <!-- =================================================
                     ТЕМПЕРАТУРЫ — ЗАГОЛОВОК
                     ================================================= -->

                <Grid Margin="4,16,4,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="3"
                            Height="15"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,9,0"/>


                    <TextBlock Grid.Column="1"
                               Text="ТЕМПЕРАТУРА НАКОПИТЕЛЕЙ"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"/>


                    <Border Grid.Column="2"
                            Height="1"
                            Margin="13,0,13,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>


                    <TextBlock Grid.Column="3"
                               Text="THERMAL SENSOR ARRAY"
                               Style="{StaticResource TechLabelStyle}"
                               VerticalAlignment="Center"/>

                </Grid>


                <Grid x:Name="StorageTemperaturePanel"/>


                <!-- =================================================
                     FOOTER
                     ================================================= -->

                <Grid Margin="0,17,0,3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Height="1"
                            Margin="0,0,14,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>


                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <TextBlock Text="THERMIQRA"
                                   Style="{StaticResource TechLabelStyle}"/>

                        <TextBlock Text="   •   "
                                   Style="{StaticResource TechLabelStyle}"/>

                        <TextBlock Text="REAL-TIME HARDWARE MONITORING"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>

                    </StackPanel>


                    <Border Grid.Column="2"
                            Height="1"
                            Margin="14,0,0,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>

                </Grid>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>