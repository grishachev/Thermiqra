<Window x:Class="PCHardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermiqra"
        Width="1400"
        Height="820"
        MinWidth="520"
        MinHeight="500"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ProgressCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Grid x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="{DynamicResource ProgressCornerRadius}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TechLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SteamHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SteamPipeProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource SteamGlassBrush}"
                                BorderBrush="{DynamicResource SteamMetalBrush}"
                                BorderThickness="2"
                                CornerRadius="16"
                                Padding="4">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="11"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="11"/>
                                <Border Height="5"
                                        Margin="8,5,8,0"
                                        VerticalAlignment="Top"
                                        Background="#28FFFFFF"
                                        CornerRadius="3"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- =========================================================
             FROST CORE — КРИОГЕННЫЕ ЭЛЕМЕНТЫ
             ========================================================= -->
        <Style x:Key="FrostHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FrostCapsuleProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource FrostGlassBrush}"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="3">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="5"/>
                                <Border Height="3"
                                        Margin="6,3,6,0"
                                        VerticalAlignment="Top"
                                        Background="#30FFFFFF"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             MILITARY OPS — ТАКТИЧЕСКИЕ ЭЛЕМЕНТЫ
             ========================================================= -->
        <Style x:Key="MilitaryHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ThermiqraScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource BorderBrush}"
                                CornerRadius="3"
                                Margin="2,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThermiqraScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="22,20,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- =====================================================
                 CYBER TECH HEADER
                 ===================================================== -->
            <Border Grid.Row="0"
                    Visibility="{DynamicResource MainCyberTechVisibility}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Width="170"
                                Height="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="18,13,18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Width="34"
                              Height="44"
                              Margin="0,0,14,0">
                            <Border Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <Border Width="15"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="3,0,0,0"
                                    Background="{DynamicResource AccentBrush}"/>
                            <Border Width="9"
                                    Height="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="3,0,0,0"
                                    Background="{DynamicResource BorderBrush}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="THERMIQRA"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <Border Margin="12,2,0,0"
                                        Padding="8,3"
                                        CornerRadius="3"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LivePulseDot"
                                                 Width="6"
                                                 Height="6"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="LIVE"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="1,4,0,0">
                                <TextBlock Text="HARDWARE MONITORING SYSTEM"
                                           Style="{StaticResource TechLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <Border Width="18"
                                        Height="1"
                                        Margin="10,0"
                                        Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText"
                                           Text="Запуск мониторинга..."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM CONTROL"
                                           Style="{StaticResource TechLabelStyle}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="REAL-TIME"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="Статистика"
                                    MinWidth="112"
                                    Margin="0,0,8,0"
                                    Click="StatisticsButton_Click"/>
                            <Button Content="Система"
                                    MinWidth="108"
                                    Margin="0,0,8,0"
                                    Click="SystemInfoButton_Click"/>
                            <Button Content="⚙  Настройки"
                                    MinWidth="126"
                                    Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =====================================================
                 STEAMPUNK HEADER — МЕХАНИЧЕСКАЯ ПАНЕЛЬ
                 ===================================================== -->
            <Border Grid.Row="0"
                    Visibility="{DynamicResource SteamPunkVisibility}"
                    Background="{DynamicResource SteamPanelBrush}"
                    BorderBrush="{DynamicResource SteamMetalBrush}"
                    BorderThickness="2"
                    CornerRadius="14"
                    Padding="7"
                    Margin="0,0,0,18">
                <Grid>
                    <Border Background="{DynamicResource SteamDarkMetalBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"/>

                    <Grid Margin="17,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Width="62"
                              Height="62"
                              Margin="0,0,16,0">
                            <Ellipse Fill="{DynamicResource SteamGlassBrush}"
                                     Stroke="{DynamicResource SteamMetalBrush}"
                                     StrokeThickness="4"/>
                            <Ellipse Width="44"
                                     Height="44"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2"/>
                            <Border Width="4"
                                    Height="42"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Border Width="42"
                                    Height="4"
                                    Background="{DynamicResource SteamMetalBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Ellipse Width="17"
                                     Height="17"
                                     Fill="{DynamicResource SteamRivetBrush}"
                                     Stroke="{DynamicResource SteamDarkMetalBrush}"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="THERMIQRA"
                                       Style="{StaticResource SteamHeadingStyle}"
                                       FontSize="28"/>
                            <TextBlock Text="МЕХАНИЧЕСКАЯ СТАНЦИЯ МОНИТОРИНГА"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="1,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Margin="24,4,24,4"
                                Background="{DynamicResource SteamGlassBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="8"
                                               FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">
                                        <Ellipse x:Name="SteamLivePulseDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="МОНИТОРИНГ АКТИВЕН"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="SteamStatusText"
                                           Grid.Column="1"
                                           Text="Запуск мониторинга..."
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="18,0,0,0"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="СТАТИСТИКА"
                                    MinWidth="118"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource SteamMetalBrush}"
                                    Background="{DynamicResource SteamGlassBrush}"
                                    Click="StatisticsButton_Click"/>
                            <Button Content="СИСТЕМА"
                                    MinWidth="108"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource SteamMetalBrush}"
                                    Background="{DynamicResource SteamGlassBrush}"
                                    Click="SystemInfoButton_Click"/>
                            <Button Content="⚙  НАСТРОЙКИ"
                                    MinWidth="132"
                                    BorderBrush="{DynamicResource SteamMetalBrush}"
                                    Background="{DynamicResource SteamGlassBrush}"
                                    Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Ellipse Width="8" Height="8" Margin="8"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{DynamicResource SteamRivetBrush}"/>
                    <Ellipse Width="8" Height="8" Margin="8"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="{DynamicResource SteamRivetBrush}"/>
                    <Ellipse Width="8" Height="8" Margin="8"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Fill="{DynamicResource SteamRivetBrush}"/>
                    <Ellipse Width="8" Height="8" Margin="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{DynamicResource SteamRivetBrush}"/>
                </Grid>
            </Border>


            <!-- =====================================================
                 FROST CORE HEADER — КРИОГЕННАЯ СТАНЦИЯ
                 ===================================================== -->
            <Border Grid.Row="0"
                    Visibility="{DynamicResource FrostCoreVisibility}"
                    Background="{DynamicResource FrostPanelBrush}"
                    BorderBrush="{DynamicResource FrostSteelBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="8"
                    Margin="0,0,0,18">
                <Grid>
                    <Border Background="{DynamicResource FrostGlassBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"/>

                    <Border Height="4"
                            Margin="28,0,28,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource FrostIceBrush}"
                            CornerRadius="0,0,5,5"
                            Opacity="0.82"/>

                    <Grid Margin="17,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Криоячейка -->
                        <Grid Grid.Column="0"
                              Width="70"
                              Height="70"
                              Margin="0,0,16,0">
                            <Border Background="{DynamicResource FrostGlassBrush}"
                                    BorderBrush="{DynamicResource FrostSteelBrush}"
                                    BorderThickness="3"
                                    CornerRadius="18"/>
                            <Border Width="48"
                                    Height="48"
                                    BorderBrush="{DynamicResource FrostIceBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Border Width="4"
                                    Height="42"
                                    Background="{DynamicResource FrostIceBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"/>
                            <Border Width="42"
                                    Height="4"
                                    Background="{DynamicResource FrostIceBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"/>
                            <Border Width="34"
                                    Height="3"
                                    Background="{DynamicResource FrostSteelBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="34"
                                    Height="3"
                                    Background="{DynamicResource FrostSteelBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse Width="13"
                                     Height="13"
                                     Fill="{DynamicResource FrostIceBrush}"
                                     Stroke="{DynamicResource FrostGlassBrush}"
                                     StrokeThickness="2"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="THERMIQRA"
                                       Style="{StaticResource FrostHeadingStyle}"
                                       FontSize="28"/>
                            <TextBlock Text="КРИОГЕННАЯ СИСТЕМА МОНИТОРИНГА"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="1,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Margin="26,4,26,4"
                                Background="#5A0D1A21"
                                BorderBrush="{DynamicResource FrostSteelBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="15,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="КРИОКОНТУР"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="8"
                                               FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">
                                        <Ellipse x:Name="FrostLivePulseDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{DynamicResource FrostIceBrush}"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="ОХЛАЖДЕНИЕ АКТИВНО"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="FrostStatusText"
                                           Grid.Column="1"
                                           Text="Запуск мониторинга..."
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="18,0,0,0"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="СТАТИСТИКА"
                                    MinWidth="118"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource FrostSteelBrush}"
                                    Background="{DynamicResource FrostGlassBrush}"
                                    Click="StatisticsButton_Click"/>
                            <Button Content="СИСТЕМА"
                                    MinWidth="108"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource FrostSteelBrush}"
                                    Background="{DynamicResource FrostGlassBrush}"
                                    Click="SystemInfoButton_Click"/>
                            <Button Content="⚙  НАСТРОЙКИ"
                                    MinWidth="132"
                                    BorderBrush="{DynamicResource FrostSteelBrush}"
                                    Background="{DynamicResource FrostGlassBrush}"
                                    Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =====================================================
                 MILITARY OPS HEADER — ТАКТИЧЕСКИЙ ПУЛЬТ
                 ===================================================== -->
            <Border Grid.Row="0"
                    Visibility="{DynamicResource MilitaryOpsVisibility}"
                    Background="{DynamicResource MilitaryPanelBrush}"
                    BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Padding="6"
                    Margin="0,0,0,18">
                <Grid>
                    <Border Background="{DynamicResource MilitaryPlateBrush}"
                            BorderBrush="{DynamicResource MilitaryGridBrush}"
                            BorderThickness="1"/>

                    <Border Height="3"
                            Margin="14,0,14,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource MilitaryKhakiBrush}"/>
                    <Border Height="3"
                            Margin="14,0,14,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource MilitaryGridBrush}"/>

                    <Grid Margin="16,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Компас -->
                        <Grid Grid.Column="0"
                              Width="68"
                              Height="68"
                              Margin="0,0,16,0">
                            <Ellipse Fill="{DynamicResource MilitaryPlateBrush}"
                                     Stroke="{DynamicResource MilitaryKhakiBrush}"
                                     StrokeThickness="2"/>
                            <Ellipse Width="50"
                                     Height="50"
                                     Stroke="{DynamicResource MilitaryGridBrush}"
                                     StrokeThickness="1"/>
