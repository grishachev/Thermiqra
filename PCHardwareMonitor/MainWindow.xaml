                                <Border x:Name="MilitaryRamSegment6" Grid.Column="6" Margin="0,0,3,0" Background="{DynamicResource MilitaryGridBrush}" BorderBrush="{DynamicResource MilitaryKhakiBrush}" BorderThickness="1"/>
                                <Border x:Name="MilitaryRamSegment7" Grid.Column="7" Margin="0,0,3,0" Background="{DynamicResource MilitaryGridBrush}" BorderBrush="{DynamicResource MilitaryKhakiBrush}" BorderThickness="1"/>
                                <Border x:Name="MilitaryRamSegment8" Grid.Column="8" Margin="0,0,3,0" Background="{DynamicResource MilitaryGridBrush}" BorderBrush="{DynamicResource MilitaryKhakiBrush}" BorderThickness="1"/>
                                <Border x:Name="MilitaryRamSegment9" Grid.Column="9" Background="{DynamicResource MilitaryGridBrush}" BorderBrush="{DynamicResource MilitaryKhakiBrush}" BorderThickness="1"/>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="РЕСУРС ПАМЯТИ / 10 СЕКТОРОВ"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Margin="1,6,0,0"/>
                        </Grid>

                        <Border Grid.Column="2"
                                Background="{DynamicResource MilitaryPanelBrush}"
                                BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                                BorderThickness="1.5"
                                Padding="12"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="ЗАНЯТО"
                                           Foreground="{DynamicResource MilitaryKhakiBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="MilitaryRamPercentText"
                                           Text="-- %"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,3"/>
                                <Border Height="2"
                                        Width="58"
                                        Background="{DynamicResource MilitaryKhakiBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,3,0,5"/>
                                <TextBlock Text="РЕЗЕРВ"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="8"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Width="28" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{DynamicResource MilitaryKhakiBrush}"/>
                    <Border Width="28" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{DynamicResource MilitaryKhakiBrush}"/>
                    <Border Width="28" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Background="{DynamicResource MilitaryKhakiBrush}"/>
                    <Border Width="28" Height="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="{DynamicResource MilitaryKhakiBrush}"/>
                </Grid>
            </Border>

            <!-- =====================================================
                 LOWER MODULES
                 ===================================================== -->
            <StackPanel Grid.Row="3">

                <!-- CYBER DISKS HEADER -->
                <Grid Margin="4,1,4,8"
                      Visibility="{DynamicResource MainCyberTechVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="15"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" Text="ДИСКИ"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Height="1" Margin="13,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="STORAGE VOLUME ARRAY"
                               Style="{StaticResource TechLabelStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- STEAMPUNK DISKS HEADER -->
                <Border Visibility="{DynamicResource SteamPunkVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SteamDarkMetalBrush}"
                        BorderBrush="{DynamicResource SteamMetalBrush}"
                        BorderThickness="2"
                        CornerRadius="7"
                        Padding="12,7"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="18"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ДИСКОВЫЕ МЕХАНИЗМЫ"
                                   Style="{StaticResource SteamHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  НАКОПИТЕЛИ"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- FROST CORE DISKS HEADER -->
                <Border Visibility="{DynamicResource FrostCoreVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource FrostGlassBrush}"
                        BorderBrush="{DynamicResource FrostSteelBrush}"
                        BorderThickness="1.5"
                        CornerRadius="11"
                        Padding="12,7"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❄"
                                   Foreground="{DynamicResource FrostIceBrush}"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="КРИОХРАНИЛИЩЕ ДАННЫХ"
                                   Style="{StaticResource FrostHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  ГЕРМЕТИЧНЫЕ МОДУЛИ"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- MILITARY OPS DISKS HEADER -->
                <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MilitaryPanelBrush}"
                        BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                        BorderThickness="2"
                        CornerRadius="1"
                        Padding="12,7"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="15"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="СЕКТОР ХРАНИЛИЩ"
                                   Style="{StaticResource MilitaryHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  КОНТЕЙНЕРЫ ДАННЫХ"
                                   Foreground="{DynamicResource MilitaryKhakiBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="DrivesPanel"/>

                <!-- CYBER TEMPERATURE HEADER -->
                <Grid Margin="4,16,4,8"
                      Visibility="{DynamicResource MainCyberTechVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="15"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" Text="ТЕМПЕРАТУРА НАКОПИТЕЛЕЙ"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Height="1" Margin="13,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="THERMAL SENSOR ARRAY"
                               Style="{StaticResource TechLabelStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- STEAMPUNK TEMPERATURE HEADER -->
                <Border Visibility="{DynamicResource SteamPunkVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SteamDarkMetalBrush}"
                        BorderBrush="{DynamicResource SteamMetalBrush}"
                        BorderThickness="2"
                        CornerRadius="7"
                        Padding="12,7"
                        Margin="0,16,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♨"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="18"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ТЕРМОМЕТРЫ НАКОПИТЕЛЕЙ"
                                   Style="{StaticResource SteamHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  КОНТРОЛЬ ТЕМПЕРАТУРЫ"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- FROST CORE TEMPERATURE HEADER -->
                <Border Visibility="{DynamicResource FrostCoreVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource FrostGlassBrush}"
                        BorderBrush="{DynamicResource FrostSteelBrush}"
                        BorderThickness="1.5"
                        CornerRadius="11"
                        Padding="12,7"
                        Margin="0,16,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❅"
                                   Foreground="{DynamicResource FrostIceBrush}"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ТЕМПЕРАТУРА КРИОМОДУЛЕЙ"
                                   Style="{StaticResource FrostHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  ТЕПЛОВОЙ КОНТРОЛЬ"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- MILITARY OPS TEMPERATURE HEADER -->
                <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MilitaryPanelBrush}"
                        BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                        BorderThickness="2"
                        CornerRadius="1"
                        Padding="12,7"
                        Margin="0,16,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌖"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ТЕПЛОВОЙ КОНТРОЛЬ СЕКТОРА"
                                   Style="{StaticResource MilitaryHeadingStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  ПОЛЕВЫЕ ДАТЧИКИ"
                                   Foreground="{DynamicResource MilitaryKhakiBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="StorageTemperaturePanel"/>

                <!-- CYBER FOOTER -->
                <Grid Margin="0,17,0,3"
                      Visibility="{DynamicResource MainCyberTechVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Margin="0,0,14,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="THERMIQRA" Style="{StaticResource TechLabelStyle}"/>
                        <TextBlock Text="   •   " Style="{StaticResource TechLabelStyle}"/>
                        <TextBlock Text="REAL-TIME HARDWARE MONITORING"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="2" Height="1" Margin="14,0,0,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- STEAMPUNK FOOTER -->
                <Border Visibility="{DynamicResource SteamPunkVisibility}"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SteamDarkMetalBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="13,5"
                        Margin="0,17,0,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="THERMIQRA"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  •  МЕХАНИЧЕСКАЯ СИСТЕМА МОНИТОРИНГА"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>



                <!-- FROST CORE FOOTER -->
                <Border Visibility="{DynamicResource FrostCoreVisibility}"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource FrostGlassBrush}"
                        BorderBrush="{DynamicResource FrostSteelBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="13,5"
                        Margin="0,17,0,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❄"
                                   Foreground="{DynamicResource FrostIceBrush}"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="THERMIQRA"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  •  КРИОГЕННАЯ СИСТЕМА МОНИТОРИНГА"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- MILITARY OPS FOOTER -->
                <Border Visibility="{DynamicResource MilitaryOpsVisibility}"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource MilitaryPanelBrush}"
                        BorderBrush="{DynamicResource MilitaryKhakiBrush}"
                        BorderThickness="1.5"
                        CornerRadius="1"
                        Padding="13,5"
                        Margin="0,17,0,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌖"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="THERMIQRA"
                                   Foreground="{DynamicResource MilitaryKhakiBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  •  ТАКТИЧЕСКИЙ ЦЕНТР МОНИТОРИНГА"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
